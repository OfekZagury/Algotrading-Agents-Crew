# Copy to .env and fill in your keys. Never commit .env.

# --- LLM: Gemini is used when GEMINI_API_KEY is set, otherwise OpenAI ---
GEMINI_API_KEY=your-gemini-key
# Any current Gemini model, e.g. gemini-3.8-flash or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-5

# --- Alpaca PAPER trading keys (https://app.alpaca.markets/paper/dashboard/overview)
# Also used as the fallback price source when Yahoo Finance is unavailable.
ALPACA_API_KEY=your-alpaca-paper-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret

# true = simulate orders instead of sending them (always on in the web demo)
DRY_RUN=false

# Comma separated list of symbols to analyze (can also be passed on the command line)
TRADING_SYMBOLS=NFLX
